# Copy to backend/.env for local development.
GROQ_API_KEY=
NVIDIA_API_KEY=
GOV_API_KEY=
CHAT_MODELS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b
EMBED_MODEL=nvidia/nemotron-3-embed-1b
RAG_MIN_DENSE_SCORE=0.35
RAG_INTENT_THRESHOLD=0.35

# Local Docker defaults. Use managed production services on Vercel.
DATABASE_URL=sqlite:///./kisaan.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Same-origin browser requests do not need CORS in Vercel services mode.
# Set this to the deployed frontend origin for separate local/preview clients.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
